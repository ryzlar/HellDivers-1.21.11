{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["firstperson_righthand", "firstperson_lefthand"],
        "model": {
          "type": "minecraft:model",
          "model": "lasermod:item/arm_piece_first"
        }
      },
      {
        "when": ["thirdperson_righthand", "thirdperson_lefthand"],
        "model": {
          "type": "minecraft:model",
          "model": "lasermod:item/arm_piece_drop"
        }
      },
      {
        "when": ["ground", "fixed"],
        "model": {
          "type": "minecraft:model",
          "model": "lasermod:item/arm_piece_drop"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "lasermod:item/arm_piece_first"
    }
  }
}